        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取稿库及其副本，现有文件已保留且未覆盖。请恢复访问后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取稿庫及其副本，現有文件已保留且未覆蓋。請恢復訪問後重試。"
          }
        }
      }
