    "A held position may be a pause or an aside. These records are only cues for review.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A held position may be a pause or an aside. These records are only cues for review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持位置也可能是停顿或自由发挥。这些记录只是回看的线索。"
