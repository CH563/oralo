        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中文：系统拼音转换，可自行校正。英文：离线 ipa-dict 美式音标。试听：系统单词示范音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中文：系統拼音轉換，可自行校正。英文：離線 ipa-dict 美式音標。試聽：系統單詞示範音。"
