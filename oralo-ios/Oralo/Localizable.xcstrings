    "Speech following uses Apple's on-device recognition. The app does not save recordings or full transcripts. If recognition is unavailable, manual reading remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech following uses Apple's on-device recognition. The app does not save recordings or full transcripts. If recognition is unavailable, manual reading remains available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音跟随使用 Apple 设备端识别。App 不保存录音或完整转写；识别不可用时，仍可手动提词。"
