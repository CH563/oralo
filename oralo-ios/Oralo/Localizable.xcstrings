    "System speech models, voices and files chosen from cloud providers may require downloads. Oralo has no account system, advertising SDK or analytics SDK.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System speech models, voices and files chosen from cloud providers may require downloads. Oralo has no account system, advertising SDK or analytics SDK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统语音模型、声音及你选择的云端文件可能需要联网下载。Oralo 未接入账号系统、广告 SDK 或统计 SDK。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統語音模型、聲音及你選擇的雲端文件可能需要聯網下載。Oralo 未接入賬號系統、廣告 SDK 或統計 SDK。"
          }
        }
      }
    },
    "System uses the new on-device model on iOS 26/27. Compatibility tests the iOS 18 recognition path. Mixed-language accuracy is experimental.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System uses the new on-device model on iOS 26/27. Compatibility tests the iOS 18 recognition path. Mixed-language accuracy is experimental."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统模式在 iOS 26/27 使用新的设备端模型；兼容模式使用 iOS 18 识别路径。混合语言准确性仍需验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統模式在 iOS 26/27 使用新的設備端模型；兼容模式使用 iOS 18 識別路徑。混合語言準確性仍需驗證。"
          }
        }
